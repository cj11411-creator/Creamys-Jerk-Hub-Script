-- Additional movement and ESP updates, all disconnected on unload.
local visualElapsed=0
on(RunService.Heartbeat,function(dt)
    if not alive then return end
    if flyActive then
        if not (selfReady() and flyRoot==root and flyVelocity and flyGyro) then
            setFly(false)
        else
            local camera=workspace.CurrentCamera
            if camera then
                local forward=camera.CFrame.LookVector
                local right=camera.CFrame.RightVector
                local move=Vector3.zero
                if UIS:IsKeyDown(Enum.KeyCode.W) then move=move+forward end
                if UIS:IsKeyDown(Enum.KeyCode.S) then move=move-forward end
                if UIS:IsKeyDown(Enum.KeyCode.A) then move=move-right end
                if UIS:IsKeyDown(Enum.KeyCode.D) then move=move+right end
                if UIS:IsKeyDown(Enum.KeyCode.Space) then move=move+Vector3.yAxis end
                local descending=UIS:IsKeyDown(Enum.KeyCode.LeftControl) or
                    UIS:IsKeyDown(Enum.KeyCode.RightControl)
                if descending then move=move-Vector3.yAxis end
                if move.Magnitude>1 then move=move.Unit end
                local boostKey=extra.flightBoostKey=="Alt"
                    and Enum.KeyCode.LeftAlt or Enum.KeyCode.LeftShift
                local boosted=UIS:IsKeyDown(boostKey)
                local verticalMultiplier=(move.Y<0 and extra.flightDescendPercent
                    or extra.flightVerticalPercent)/100
                local targetVelocity=Vector3.new(move.X,
                    move.Y*verticalMultiplier,move.Z)*flySpeed
                    *(boosted and extra.flightBoost or 1)
                local smooth=extra.flightSmoothing/100
                local alpha=1-smooth^(math.max(dt,1/120)*60)
                extra.flightCurrentVelocity=(extra.flightCurrentVelocity or Vector3.zero):Lerp(
                    targetVelocity,math.clamp(alpha,0,1))
                flyVelocity.Velocity=extra.flightCurrentVelocity
                local flat=Vector3.new(forward.X,0,forward.Z)
                if extra.flightFacing=="Travel Direction" then
                    local travel=Vector3.new(move.X,0,move.Z)
                    if travel.Magnitude>.05 then flat=travel end
                end
                if flat.Magnitude>.05 then
                    flyGyro.CFrame=CFrame.lookAt(root.Position,root.Position+flat.Unit)
                end
            end
        end
    end
    if noclipActive and char and char.Parent then
        for _,part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and
                (extra.noclipAccessories=="Include" or
                    not part:FindFirstAncestorOfClass("Accessory")) and
                (noclipScope=="All Parts" or
                    (part.Name~="HumanoidRootPart" and part.Name~="Head")) then
                if noclipParts[part]==nil then
                    noclipParts[part]=part.CanCollide
                end
                part.CanCollide=false
            end
        end
    end
    if hum and hum.Parent and hum.Health>0 then
        if speedActive then
            local sprintKey=extra.sprintKey=="Alt"
                and Enum.KeyCode.LeftAlt or Enum.KeyCode.LeftShift
            local sprinting=extra.sprintMode=="Always" or UIS:IsKeyDown(sprintKey)
            hum.WalkSpeed=walkSpeedValue*(sprinting and extra.sprintMultiplier or 1)
        end
        if jumpActive then
            if hum.UseJumpPower then hum.JumpPower=jumpPowerValue
            else hum.JumpHeight=jumpHeightValue end
        end
    end
    if hum and hum.Parent and hum.FloorMaterial~=Enum.Material.Air then
        extra.airJumpCount=0
    end
    visualElapsed=visualElapsed+dt
    if visualElapsed>=extra.espRefreshRate then
        visualElapsed=0
        updateVisuals()
    end
end)
-- Camera aim assistance and UI FOV circle. This uses the game camera,
-- not a server remote, and only provides input-side tracking.
on(RunService.RenderStepped,function(dt)
    if not alive then return end
    local a=extra.aim
    local camera=workspace.CurrentCamera
    if not camera then
        a.ring.Visible=false
        a.partNow=nil
        a.positionNow=nil
        return
    end
    local center=a.centerPoint(camera)
    local r=a.radius
    a.ring.Visible=a.showFov
    if a.showFov then
        a.ring.Size=UDim2.fromOffset(r*2,r*2)
        a.ring.Position=UDim2.fromOffset(center.X-r,center.Y-r)
        a.ringStroke.Thickness=a.strokeWidth
        a.ringStroke.Transparency=1-a.circleOpacity/100
    end
    if a.enabled or a.silent then
        a.partNow,a.positionNow=a.findTarget(camera)
    else
        a.partNow=nil
        a.positionNow=nil
    end
    if a.enabled and a.positionNow then
        local activated=a.activation=="Always" or
            UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
        if activated then
            local targetCF=CFrame.lookAt(camera.CFrame.Position,a.positionNow)
            local strength=math.clamp(a.smooth/100,.01,1)
            local t=1-(1-strength)^(math.max(0,dt or 1/60)*60)
            camera.CFrame=camera.CFrame:Lerp(targetCF,math.clamp(t,0,1))
        end
    end
end)
