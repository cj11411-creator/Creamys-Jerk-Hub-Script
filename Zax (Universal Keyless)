local function applyTheme()
    local oldColors={}
    for role,value in pairs(C) do oldColors[role]=value end
    local nextColors=buildPalette(paletteName)
    for role,value in pairs(nextColors) do C[role]=value end
    -- The explicit registry handles regular UI objects. The fallback below
    -- also catches accents changed by runtime events / tweens before a theme
    -- switch, without touching fixed preview swatches or other games' UI.
    for object,roles in pairs(themedObjects) do
        if object.Parent then
            for prop,role in pairs(roles) do
                pcall(function() object[prop]=C[role] end)
            end
        end
    end
    for grad,roles in pairs(themedGradients) do
        if grad.Parent then
            grad.Color=ColorSequence.new(C[roles[1]],C[roles[2]])
        end
    end
    for _,object in ipairs(gui:GetDescendants()) do
        if not staticPreviewObjects[object] then
            local registry=themedObjects[object]
            for _,prop in ipairs(themeColorProps) do
                if not (registry and registry[prop]) then
                    local ok,current=pcall(function() return object[prop] end)
                    if ok and current~=nil then
                        for _,role in ipairs(themeRoles) do
                            if current==oldColors[role] then
                                pcall(function() object[prop]=C[role] end)
                                break
                            end
                        end
                    end
                end
            end
        end
    end
    -- Active states have their own colors; reapply after the general palette.
    if refreshToggles then refreshToggles() end
    for _,item in ipairs(featureCards) do
        for _,refresh in ipairs(item.settingsRefreshes) do refresh() end
    end
    for id,ui in pairs(navButtons) do
        ui.button.BackgroundColor3=id==activePage and C.badge or C.rail
        ui.text.TextColor3=id==activePage and C.text or C.dim
        ui.indicator.BackgroundTransparency=id==activePage and 0 or 1
    end
    updateColorStudio()
    applyGlassOpacity()
    extra.edge.applyStyle()
    saveTheme()
end
