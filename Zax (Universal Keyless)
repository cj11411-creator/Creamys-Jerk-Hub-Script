-- Every themed property is tracked without keeping destroyed roster cells alive.
local C
local themedObjects = setmetatable({}, {__mode = "k"})
local themedGradients = setmetatable({}, {__mode = "k"})
local themeRoles = {"canvas","rail","panel","card","hover","stroke",
    "text","dim","mint","blue","orange","pink","selected","badge"}
local themeColorProps = {"BackgroundColor3","TextColor3","ImageColor3",
    "ScrollBarImageColor3","Color"}
local function colorRole(value)
    if not C or value == nil then return nil end
    for _, role in ipairs(themeRoles) do
        if C[role] == value then return role end
    end
    return nil
end
local function create(class, props, parent)
    local obj = Instance.new(class)
    for k, v in pairs(props or {}) do obj[k] = v end
    if parent then obj.Parent = parent end
    local assigned = {}
    for _, prop in ipairs(themeColorProps) do
        if props and props[prop] then
            local role = colorRole(props[prop])
            if role then assigned[prop] = role end
        end
    end
    if next(assigned) then themedObjects[obj] = assigned end
    return obj
end
-- Track GUI edges so roundness/softness can update every panel live.
extra.edge={corners=setmetatable({}, {__mode="k"}),strokes=setmetatable({}, {__mode="k"})}
function extra.edge.roundPixels(base)
    return math.max(2, math.floor(base*extra.cornerRoundness+.5))
end
function extra.edge.softenedAlpha(alpha)
    return math.clamp(alpha+(1-alpha)*extra.borderSoftness/100,0,1)
end
local function rounded(obj, r)
    local original=r or 11
    local corner=create("UICorner", {CornerRadius=UDim.new(0,extra.edge.roundPixels(original))},obj)
    extra.edge.corners[corner]=original
    return obj
end
local function stroke(obj, c, alpha, thick)
    local original=alpha or 0
    local outline=create("UIStroke", {Color=c, Transparency=extra.edge.softenedAlpha(original),
        Thickness=thick or 1, ApplyStrokeMode=Enum.ApplyStrokeMode.Border},obj)
    extra.edge.strokes[outline]=original
    return outline
end
function extra.edge.applyStyle()
    for obj,base in pairs(extra.edge.corners) do
        if obj.Parent then obj.CornerRadius=UDim.new(0,extra.edge.roundPixels(base)) end
    end
    -- Keep the sidebar's outside corners matched to the outer window when
    -- the Appearance > Corner Roundness slider changes.
    local sidebar=extra.edge.sidebarCorners
    if sidebar and sidebar.Parent then
        local radius=UDim.new(0,extra.edge.roundPixels(24))
        sidebar.TopLeftRadius=radius
        sidebar.BottomLeftRadius=radius
        sidebar.TopRightRadius=UDim.new(0,0)
        sidebar.BottomRightRadius=UDim.new(0,0)
    end
    for obj,base in pairs(extra.edge.strokes) do
        if obj.Parent then obj.Transparency=extra.edge.softenedAlpha(base) end
    end
end
local function gradient(obj, first, second, angle)
    local grad = create("UIGradient", {Color = ColorSequence.new(first,second),
        Rotation = angle or 0}, obj)
    local firstRole, secondRole = colorRole(first), colorRole(second)
    if firstRole and secondRole then
        themedGradients[grad] = {firstRole, secondRole}
    end
    return grad
end
local function animate(obj, time, props)
    if not alive or not obj or not obj.Parent then return end
    if extra.uiMotion=="Off" then
        for property,value in pairs(props) do obj[property]=value end
        return
    end
    local t = TweenService:Create(obj,
        TweenInfo.new(time or .18, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), props)
    t:Play()
end

