-- Target interaction uses only the local character.
local function restoreContact()
    if previousRoot and previousRoot.Parent then
        pcall(function()
            previousRoot.AssemblyLinearVelocity=Vector3.zero
            previousRoot.AssemblyAngularVelocity=Vector3.zero
            if previousCollision~=nil then previousRoot.CanCollide=previousCollision end
            if previousCF then previousRoot.CFrame=previousCF*CFrame.new(0,extra.flingReturnHeight,0) end
        end)
    end
    if previousHum and previousHum.Parent and previousAutoRotate~=nil then
        pcall(function() previousHum.AutoRotate=previousAutoRotate end)
    end
    previousRoot=nil
    previousHum=nil
    previousCF=nil
    previousCollision=nil
    previousAutoRotate=nil
    contactBusy=false
end
local function contact(kind)
    if contactBusy then message("Busy","The current physics attempt is still running") return end
    local tr,p=requireTarget()
    if not tr then return end
    if tr.Anchored then message("Anchored target","Physics contact is blocked") return end
    if extra.flingMaxDistance>0 and (tr.Position-root.Position).Magnitude>extra.flingMaxDistance then
        message("Too far away","Select a player within "..extra.flingMaxDistance.." studs")
        return
    end
    if flyActive and setFly then setFly(false) end
    contactToken=contactToken+1
    local token=contactToken
    local ourRoot,ourHum=root,hum
    previousRoot,previousHum=ourRoot,ourHum
    previousCF,previousCollision,previousAutoRotate=
        ourRoot.CFrame,ourRoot.CanCollide,ourHum.AutoRotate
    contactBusy=true
    message("Contact attempt",kind.." near "..p.DisplayName.." (beta)")
    task.spawn(function()
        local success,err=pcall(function()
            ourHum.AutoRotate=false
            local start=os.clock()
            local frame=0
            local duration=flingDuration
            while alive and token==contactToken and ourRoot.Parent and tr.Parent
                and ourHum.Parent and ourHum.Health>0
                and os.clock()-start<duration do
                RunService.Heartbeat:Wait()
                if not alive or token~=contactToken then break end
                frame=frame+1
                local side=tr.CFrame.RightVector*((frame%2==0) and extra.flingContactOffset or -extra.flingContactOffset)
                local p0=tr.Position+side+Vector3.new(0,.25,0)
                ourRoot.CanCollide=true
                ourRoot.CFrame=CFrame.new(p0)
                local direction=tr.Position-p0
                if direction.Magnitude<.05 then direction=tr.CFrame.LookVector end
                local linear=flingPower
                local vertical=math.floor(flingPower*extra.flingLiftPercent/100)
                local angular=math.floor(flingPower*1.32)
                ourRoot.AssemblyLinearVelocity=direction.Unit*linear+Vector3.new(0,vertical,0)
                ourRoot.AssemblyAngularVelocity=Vector3.new(0,angular,0)
            end
        end)
        if token==contactToken then
            restoreContact()
            if not success then warn("[ZAX Universal Hub] contact:",err) end
            if alive then message("Attempt finished","Check another player's view; FE is not guaranteed") end
        end
    end)
end

-- Aim helper state is encapsulated to avoid changing existing movement/ESP logic.
extra.aim = {
    enabled=false,silent=false,showFov=false,
    radius=180,strokeWidth=2,circleOpacity=85,
    smooth=38,activation="Hold Right Mouse",part="Head",prediction=.06,
    teamFilter="On",wallCheck="Off",maxDistance=0,
    partNow=nil,positionNow=nil,hookState=nil,
}
function extra.aim.aimPoint()
    local a=extra.aim
    if a.partNow and a.partNow.Parent and a.positionNow then
        return a.partNow,a.positionNow
    end
    return nil,nil
end
function extra.aim.centerPoint(camera)
    -- Screen center is fixed; FOV and target search never follow the mouse.
    return Vector2.new(camera.ViewportSize.X*0.5,camera.ViewportSize.Y*0.5)
end
function extra.aim.findTarget(camera)
    local a=extra.aim
    local center=extra.aim.centerPoint(camera)
    local bestPart,bestPos,bestScore=nil,nil,a.radius*a.radius
    local myPosition=root and root.Parent and root.Position or camera.CFrame.Position
    for _,p in ipairs(Players:GetPlayers()) do
        if p~=me and (a.teamFilter~="On" or not me.Team or p.Team~=me.Team) then
            local character=p.Character
            local humanoid=character and character:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.Health>0 then
                local part=character:FindFirstChild(a.part)
                    or character:FindFirstChild("Head")
                    or character:FindFirstChild("HumanoidRootPart")
                if part and part:IsA("BasePart") then
                    local position=part.Position + part.AssemblyLinearVelocity*a.prediction
                    if a.maxDistance==0 or (position-myPosition).Magnitude<=a.maxDistance then
                        local screen,inView=camera:WorldToViewportPoint(position)
                        if inView and screen.Z>0 then
                            local dx,dy=screen.X-center.X,screen.Y-center.Y
                            local score=dx*dx+dy*dy
                            if score<bestScore then
                                local clear=true
                                if a.wallCheck=="On" then
                                    local params=RaycastParams.new()
                                    params.FilterType=Enum.RaycastFilterType.Exclude
                                    params.FilterDescendantsInstances={me.Character,camera}
                                    local direction=position-camera.CFrame.Position
                                    local hit=workspace:Raycast(camera.CFrame.Position,direction,params)
                                    clear=(hit==nil or hit.Instance:IsDescendantOf(character))
                                end
                                if clear then
                                    bestPart,bestPos,bestScore=part,position,score
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return bestPart,bestPos
end
-- Install a single reusable compatibility hook per executor session. The
-- original index handler remains in place; unload disables this hook's effect.
function extra.aim.enableLegacyHook()
    local a=extra.aim
    local shared=globalEnv.ZAXLegacyMouseHook
    if type(shared)=="table" and shared.installed then
        shared.active=true
        shared.getAim=extra.aim.aimPoint
        a.hookState=shared
        return true
    end
    if type(hookmetamethod)~="function" then return false end
    local mouse=me:GetMouse()
    if not mouse then return false end
    shared={installed=false,active=false,mouse=mouse,getAim=extra.aim.aimPoint}
    local oldIndex
    local wrapper=function(self,key)
        if shared.active and self==shared.mouse and (key=="Hit" or key=="Target") then
            local caller=false
            if type(checkcaller)=="function" then
                local ok,result=pcall(checkcaller)
                caller=ok and result or false
            end
            if not caller then
                local part,position=shared.getAim()
                if part and position then
                    if key=="Target" then return part end
                    if key=="Hit" then return CFrame.new(position) end
                end
            end
        end
        return oldIndex(self,key)
    end
    local ok,previous=pcall(function()
        return hookmetamethod(game,"__index",
            type(newcclosure)=="function" and newcclosure(wrapper) or wrapper)
    end)
    if not ok or type(previous)~="function" then return false end
    oldIndex=previous
    shared.installed=true
    shared.active=true
    globalEnv.ZAXLegacyMouseHook=shared
    a.hookState=shared
    return true
end
