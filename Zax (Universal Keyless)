-- Fully reversible cleanup of this instance.
unload=function()
    if not alive then return end
    contactToken=contactToken+1
    if contactBusy then restoreContact() end
    if flyActive then setFly(false) else removeFlightObjects() end
    noclipActive=false
    restoreNoclip()
    speedActive=false
    jumpActive=false
    infiniteJumpActive=false
    restoreMovement()
    clearVisuals()
    extra.clickTeleportEnabled=false
    extra.aim.enabled=false
    extra.aim.silent=false
    extra.aim.showFov=false
    if extra.aim.hookState then
        extra.aim.hookState.active=false
        extra.aim.hookState.getAim=function() return nil,nil end
    end
    extra.overlay.boxes=false
    extra.overlay.destroy()
    alive=false
    version=version+1
    for _,connection in ipairs(rosterConnections) do
        pcall(function() connection:Disconnect() end)
    end
    table.clear(rosterConnections)
    for _,connection in ipairs(connections) do
        pcall(function() connection:Disconnect() end)
    end
    table.clear(connections)
    if gui.Parent then gui:Destroy() end
    if globalEnv.CreamysChaosLabUnload==unload then
        globalEnv.CreamysChaosLabUnload=nil
    end
end
