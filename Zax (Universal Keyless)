local function validTarget()
    if selected and selected.Parent==Players and selected~=me then
        return selected
    end
    if searchText=="" then return nil end
    local query = string.lower(searchText)
    for _,p in ipairs(Players:GetPlayers()) do
        if p~=me and (string.lower(p.Name)==query or string.lower(p.DisplayName)==query) then
            return p
        end
    end
    for _,p in ipairs(Players:GetPlayers()) do
        if p~=me and (string.lower(p.Name):sub(1,#query)==query or
            string.lower(p.DisplayName):sub(1,#query)==query) then return p end
    end
end
local function targetReady()
    local p=validTarget()
    local h=p and p.Character and p.Character:FindFirstChildOfClass("Humanoid")
    local r=p and p.Character and p.Character:FindFirstChild("HumanoidRootPart")
    if h and h.Health>0 and r and r.Parent then return r,p,h end
end
local function selfReady()
    return hum and hum.Parent and hum.Health>0 and
        root and root.Parent and not root.Anchored
end
local function requireTarget()
    if not selfReady() then
        message("Avatar unavailable","Respawn or wait for your character")
        return nil
    end
    local tr,p,th=targetReady()
    if not tr then
        message("Select a target","Use the live player list on the right")
        return nil
    end
    return tr,p,th
end
local function face(position,other)
    return CFrame.lookAt(position,Vector3.new(other.X,position.Y,other.Z))
end

