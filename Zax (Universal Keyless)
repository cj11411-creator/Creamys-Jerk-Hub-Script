local function hexColor(value)
    return Color3.fromRGB(
        tonumber(value:sub(1,2),16),
        tonumber(value:sub(3,4),16),
        tonumber(value:sub(5,6),16))
end
-- Versioned theme preference starts the redesigned hub in graphite rather
-- than inheriting an old Rose/Evergreen preference from prior NOX builds.
local savedTheme = globalEnv.CreamysChaosLabThemeGraphite
if type(savedTheme)~="table" then savedTheme={} end
local paletteName = palettes[savedTheme.preset] and savedTheme.preset or "Graphite"
local accentHue = math.clamp(tonumber(savedTheme.hue) or .44,0,1)
local accentSaturation = math.clamp(tonumber(savedTheme.saturation) or .72,.18,1)
local customAccent = savedTheme.custom==true
local surfaceOpacity = math.clamp(tonumber(savedTheme.opacity) or .14, 0, .32)
local function buildPalette(name)
    local preset=palettes[name] or palettes.Graphite
    local colors={}
    for role,hex in pairs(preset) do colors[role]=hexColor(hex) end
    if customAccent then
        colors.mint=Color3.fromHSV(accentHue,accentSaturation,1)
        colors.blue=Color3.fromHSV((accentHue+.105)%1,accentSaturation*.85,1)
        colors.orange=Color3.fromHSV((accentHue+.36)%1,.72,1)
        colors.pink=Color3.fromHSV((accentHue+.8)%1,.74,1)
    end
    -- Every action accent follows the chosen theme instead of leaving
    -- pink / orange / blue accents stuck on the old palette.
    colors.blue=colors.mint:Lerp(colors.text,.24)
    colors.orange=colors.mint:Lerp(colors.dim,.20)
    colors.pink=colors.mint
    colors.selected=colors.card:Lerp(colors.mint,.22)
    colors.badge=colors.rail:Lerp(colors.mint,.17)
    return colors
end
C = buildPalette(paletteName)
local function colorHex(color)
    return string.format("#%02X%02X%02X",
        math.floor(color.R*255+.5),
        math.floor(color.G*255+.5),
        math.floor(color.B*255+.5))
end

