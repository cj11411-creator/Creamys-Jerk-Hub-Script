            },row.container),6)
            local fill=rounded(create("Frame",{
                Size=UDim2.fromScale(0,1),BackgroundColor3=C.mint,
                BorderSizePixel=0,
            },track),6)
            local thumb=rounded(create("TextButton",{
                AnchorPoint=Vector2.new(.5,.5),
                Position=UDim2.fromScale(0,.5),Size=UDim2.fromOffset(17,19),
                BackgroundColor3=C.text,BorderSizePixel=0,
                Text="",AutoButtonColor=false,ZIndex=3,
            },track),6)
            stroke(thumb,C.canvas,.40)
            create("TextLabel",{
                Position=UDim2.fromOffset(5,54),Size=UDim2.fromOffset(170,17),
                BackgroundTransparency=1,Text=tostring(display(min)),
                TextColor3=C.dim,Font=Enum.Font.Gotham,TextSize=10,
                TextXAlignment=Enum.TextXAlignment.Left,
            },row.container)
            create("TextLabel",{
                Position=UDim2.fromOffset(328,54),Size=UDim2.fromOffset(174,17),
                BackgroundTransparency=1,Text=tostring(display(max)),
                TextColor3=C.dim,Font=Enum.Font.Gotham,TextSize=10,
                TextXAlignment=Enum.TextXAlignment.Right,
            },row.container)
            local function normalize(v)
                v=math.clamp(v,min,max)
                v=min+math.floor((v-min)/step+.5)*step
                return math.clamp(math.floor(v*10000+.5)/10000,min,max)
            end
            row.refresh=function()
                if not valueBox.Parent then return end
                local v=math.clamp(tonumber(get()) or min,min,max)
                local ratio=(max>min) and (v-min)/(max-min) or 0
                fill.Size=UDim2.fromScale(ratio,1)
                thumb.Position=UDim2.fromScale(ratio,.5)
                if not valueBox:IsFocused() then
                    valueBox.Text=tostring(display(v))
                end
            end
            local function updateFromX(x)
                if not alive then return end
                local width=math.max(track.AbsoluteSize.X,1)
                local ratio=math.clamp((x-track.AbsolutePosition.X)/width,0,1)
                set(normalize(min+(max-min)*ratio))
                row.refresh()
            end
            local dragType=nil
            local function beginDrag(input)
                if input.UserInputType==Enum.UserInputType.MouseButton1 or
                    input.UserInputType==Enum.UserInputType.Touch then
                    dragType=input.UserInputType
                    updateFromX(input.Position.X)
                end
            end
            on(track.InputBegan,beginDrag)
            on(thumb.InputBegan,beginDrag)
            on(UIS.InputChanged,function(input)
                if not dragType then return end
                if (dragType==Enum.UserInputType.Touch and
                    input.UserInputType==Enum.UserInputType.Touch) or
                    (dragType==Enum.UserInputType.MouseButton1 and
                    input.UserInputType==Enum.UserInputType.MouseMovement) then
                    updateFromX(input.Position.X)
                end
            end)
            on(UIS.InputEnded,function(input)
                if input.UserInputType==dragType then dragType=nil end
            end)
            on(valueBox.FocusLost,function()
                local raw=valueBox.Text or ""
                local num=tonumber(raw:match("^%s*(%-?%.%d+)") or
                    raw:match("%-?%d+%.?%d*"))
                if num and spec.inputScale and num>max then
                    num=num/spec.inputScale
                end
                if num then set(normalize(num)) end
                row.refresh()
            end)
        else
            -- A categorical setting cannot meaningfully be a numeric slider.
            -- Show all available choices in one clean segmented row.
            local choices=spec
            local count=#choices
            local gap=6
            local buttonWidth=(503-gap*(count-1))/count
            local buttons={}
            for i,option in ipairs(choices) do
                local name=type(option)=="table" and option.label or option
                local value=type(option)=="table" and option.value or option
                local btn=rounded(create("TextButton",{
                    Position=UDim2.fromOffset((i-1)*(buttonWidth+gap)+2,31),
                    Size=UDim2.fromOffset(buttonWidth,33),
                    Text=tostring(name),Font=Enum.Font.GothamMedium,
                    TextSize=11,TextColor3=C.dim,
                    BackgroundColor3=C.rail,BorderSizePixel=0,
                    AutoButtonColor=false,
                },row.container),8)
                stroke(btn,C.stroke,.76)
                buttons[i]={button=btn,value=value}
                on(btn.MouseButton1Click,function()
                    if not alive then return end
                    set(value)
                    row.refresh()
                end)
            end
            row.refresh=function()
                for _,option in ipairs(buttons) do
                    local active=get()==option.value
                    option.button.BackgroundColor3=active and C.badge or C.rail
                    option.button.TextColor3=active and C.mint or C.dim
                end
            end
        end
        table.insert(rows,row)
        table.insert(refreshes,row.refresh)
        row.refresh()
        positionRows()
    end
    on(expand.MouseButton1Click,function()
        expanded=not expanded
        positionRows()
    end)
    on(primary.MouseButton1Click,function()
        if alive and callback then callback() end
    end)
    on(card.MouseEnter,function()
        if alive then
            animate(outline,.16,{Transparency=extra.edge.softenedAlpha(.36)})
            animate(card,.16,{BackgroundColor3=C.hover})
        end
    end)
    on(card.MouseLeave,function()
        if alive then
            animate(outline,.16,{Transparency=extra.edge.softenedAlpha(.72)})
            animate(card,.16,{BackgroundColor3=C.card})
        end
    end)
    table.insert(featureCards,{card=card,expand=expand,settingsRefreshes=refreshes})
    return primary,addSetting
end

