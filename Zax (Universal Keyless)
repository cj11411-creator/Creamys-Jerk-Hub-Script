-- Responsive 2D Box ESP (local-only).
-- Position updates happen every rendered frame so boxes track the camera/characters.
-- Expensive GetBoundingBox calls are cached per character and refreshed periodically.
do
    local previousLayer=playerGui:FindFirstChild("ZAX_PlayerOverlay2D")
    if previousLayer then previousLayer:Destroy() end
    local layer=Instance.new("ScreenGui")
    layer.Name="ZAX_PlayerOverlay2D"
    layer.ResetOnSpawn=false
    layer.IgnoreGuiInset=true
    layer.DisplayOrder=15
    layer.ZIndexBehavior=Enum.ZIndexBehavior.Sibling
    layer.Parent=playerGui
    local records={}

    local function remove(p)
        local item=records[p]
        if not item then return end
        if item.frame then item.frame:Destroy() end
        records[p]=nil
    end
    function extra.overlay.clear()
        for p in pairs(records) do remove(p) end
    end
    function extra.overlay.destroy()
        extra.overlay.clear()
        if layer.Parent then layer:Destroy() end
    end
    local function recordFor(p,model)
        local item=records[p]
        if item and item.model==model then return item end
        if item then remove(p) end
        local outlineFrame=Instance.new("Frame")
        outlineFrame.Name="ZAX_BoxESP"
        outlineFrame.BackgroundTransparency=1
        outlineFrame.BorderSizePixel=0
        outlineFrame.Visible=false
        outlineFrame.Parent=layer
        local outline=Instance.new("UIStroke")
        outline.Color=C.mint
        outline.Thickness=extra.overlay.boxWidth
        outline.Parent=outlineFrame
        item={model=model,frame=outlineFrame,stroke=outline,
            relativeBounds=nil,boundsSize=nil,nextBoundsAt=0}
        records[p]=item
        return item
    end

    local function getCachedBounds(item,model,targetRoot,now)
        if item.boundsSize and now<item.nextBoundsAt then return true end
        -- Cache geometry relative to the target root, so movement and camera
        -- tracking don't require GetBoundingBox on every frame.
        item.nextBoundsAt=now+extra.overlay.boundsRefresh
        local ok,cf,size=pcall(function() return model:GetBoundingBox() end)
        if ok and cf and size then
            item.relativeBounds=targetRoot.CFrame:ToObjectSpace(cf)
            item.boundsSize=size
            return true
        end
        return item.relativeBounds~=nil
    end

    function extra.overlay.update(dt)
        local opt=extra.overlay
        if not alive then return end
        if not opt.boxes then
            if next(records) then opt.clear() end
            return
        end
        local camera=workspace.CurrentCamera
        if not camera then return end
        local viewport=camera.ViewportSize
        local now=os.clock()
        local seen={}
        for _,p in ipairs(Players:GetPlayers()) do
            if p~=me then
                seen[p]=true
                local model=p.Character
                local targetRoot=model and model:FindFirstChild("HumanoidRootPart")
                local targetHum=model and model:FindFirstChildOfClass("Humanoid")
                local sameTeam=teamCheckActive and ((me.Team~=nil and p.Team==me.Team)
                    or (teamFilterMode=="teamneutral" and p.Neutral and me.Neutral))
                local distance=(root and root.Parent and targetRoot)
                    and (root.Position-targetRoot.Position).Magnitude or nil
                if not model or not targetRoot or not targetHum or targetHum.Health<=0
                    or sameTeam or not distance or (opt.boxRange~=0 and distance>opt.boxRange) then
                    remove(p)
                else
                    local item=recordFor(p,model)
                    item.stroke.Color=(opt.colorMode=="Team" and p.Team and p.TeamColor.Color) or C.mint
                    item.stroke.Thickness=opt.boxWidth
                    -- Calculate geometry infrequently; project using the live root
                    -- transform every frame to remove visible lag during running.
                    local boundsReady=getCachedBounds(item,model,targetRoot,now)
                    local center,onScreen=camera:WorldToViewportPoint(targetRoot.Position)
                    item.frame.Visible=false
                    if boundsReady and center.Z>0 and onScreen then
                        local cf=targetRoot.CFrame*item.relativeBounds
                        local size=item.boundsSize
                        local minX,minY,maxX,maxY=math.huge,math.huge,-math.huge,-math.huge
                        local allInFront=true
                        for sx=-1,1,2 do
                            for sy=-1,1,2 do
                                for sz=-1,1,2 do
                                    local corner=cf:PointToWorldSpace(Vector3.new(
                                        size.X*sx*.5,size.Y*sy*.5,size.Z*sz*.5))
                                    local screen=camera:WorldToViewportPoint(corner)
                                    if screen.Z<=0 then allInFront=false end
                                    minX=math.min(minX,screen.X)
                                    minY=math.min(minY,screen.Y)
                                    maxX=math.max(maxX,screen.X)
                                    maxY=math.max(maxY,screen.Y)
                                end
                            end
                        end
                        local width,height=maxX-minX,maxY-minY
                        if allInFront and width>1 and height>1
                            and width<viewport.X*3 and height<viewport.Y*3 then
                            item.frame.Position=UDim2.fromOffset(minX,minY)
                            item.frame.Size=UDim2.fromOffset(width,height)
                            item.frame.Visible=true
                        end
                    end
                end
            end
        end
        for p in pairs(records) do
            if not seen[p] then remove(p) end
        end
    end
end

