-- v2 click-teleport handler. Never trigger on buttons/textboxes.
on(UIS.InputBegan,function(input,processed)
    if not alive or not extra.clickTeleportEnabled then return end
    if processed or UIS:GetFocusedTextBox() or flyActive or contactBusy then return end
    if input.UserInputType~=Enum.UserInputType.MouseButton1 then return end
    local modifier=extra.clickTeleportModifier
    local held
    if modifier=="Alt" then
        held=UIS:IsKeyDown(Enum.KeyCode.LeftAlt) or UIS:IsKeyDown(Enum.KeyCode.RightAlt)
    else
        held=UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.RightControl)
    end
    if not held or not selfReady() then return end
    local camera=workspace.CurrentCamera
    if not camera then return end
    local mouse=UIS:GetMouseLocation()
    local ray=camera:ViewportPointToRay(mouse.X,mouse.Y)
    local params=RaycastParams.new()
    params.FilterType=Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances={char}
    local hit=workspace:Raycast(ray.Origin,ray.Direction*3000,params)
    if not hit then
        message("Click teleport","No surface under the cursor")
        return
    end
    local destination=hit.Position+Vector3.new(0,extra.clickTeleportHeight,0)
    local maxDistance=extra.clickTeleportMaxDistance
    if maxDistance>0 and (destination-root.Position).Magnitude>maxDistance then
        message("Click teleport","Destination exceeds your range setting")
        return
    end
    local rotation=root.CFrame-root.CFrame.Position
    root.CFrame=CFrame.new(destination)*rotation
end)

