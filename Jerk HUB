-- DRAGGING
local dragging = false
local dragStart
local startPos

connect(title.InputBegan, function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = frame.Position
    end
end)

connect(UIS.InputEnded, function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

connect(UIS.InputChanged, function(input)
    if not dragging then return end

    if input.UserInputType ~= Enum.UserInputType.MouseMovement
        and input.UserInputType ~= Enum.UserInputType.Touch then
        return
    end

    local delta = input.Position - dragStart

    frame.Position = UDim2.new(
        startPos.X.Scale,
        startPos.X.Offset + delta.X,
        startPos.Y.Scale,
        startPos.Y.Offset + delta.Y
    )
end)

-- SPEED SLIDER CONTROL
local sliding = false

local function updateSpeed(x)
    local position = math.clamp(
        (x - slider.AbsolutePosition.X) / slider.AbsoluteSize.X,
        0,
        1
    )

    speed = math.floor(1 + position * 24 + 0.5)

    local ratio = (speed - 1) / 24
    fill.Size = UDim2.fromScale(ratio, 1)
    knob.Position = UDim2.fromScale(ratio, 0.5)
    speedLabel.Text = "Speed: " .. speed
end

local function beginSlide(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        sliding = true
        updateSpeed(input.Position.X)
    end
end

connect(slider.InputBegan, beginSlide)
connect(knob.InputBegan, beginSlide)

connect(UIS.InputChanged, function(input)
    if not sliding then return end

    if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
        updateSpeed(input.Position.X)
    end
end)

connect(UIS.InputEnded, function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        sliding = false
    end
end)

-- RESTORE ARM JOINTS
local function restoreArm()
    if shoulder and shoulder.Parent and originalShoulder then
        shoulder.C0 = originalShoulder
        shoulder.Transform = CFrame.identity
    end

    if elbow and elbow.Parent and originalElbow then
        elbow.C0 = originalElbow
        elbow.Transform = CFrame.identity
    end

    if wrist and wrist.Parent and originalWrist then
        wrist.C0 = originalWrist
        wrist.Transform = CFrame.identity
    end
end

-- FIND MOTOR
local function findMotor(character, motorName)
    for _, object in ipairs(character:GetDescendants()) do
        if object:IsA("Motor6D")
            and object.Name == motorName then
            return object
        end
    end

    return nil
end

-- CHARACTER SETUP
local function setupCharacter(character)
    characterVersion = characterVersion + 1
    local thisVersion = characterVersion

    shoulder, elbow, wrist = nil, nil, nil
    originalShoulder, originalElbow, originalWrist =
        nil, nil, nil

    local humanoid = character:WaitForChild("Humanoid", 10)
    if unloaded or thisVersion ~= characterVersion then return end
    if not humanoid then return end

    if humanoid.RigType ~= Enum.HumanoidRigType.R15 then
        warn("R15 character required")
        return
    end

    local upper = character:WaitForChild("RightUpperArm", 10)
    local lower = character:WaitForChild("RightLowerArm", 10)
    local hand = character:WaitForChild("RightHand", 10)

    if unloaded or thisVersion ~= characterVersion then return end
    if not upper or not lower or not hand then return end

    shoulder = findMotor(character, "RightShoulder")
    elbow = findMotor(character, "RightElbow")
    wrist = findMotor(character, "RightWrist")

    if not shoulder or not elbow then
        warn("R15 arm joints not found")
        return
    end

    originalShoulder = shoulder.C0
    originalElbow = elbow.C0

    if wrist then
        originalWrist = wrist.C0
    end
end

connect(player.CharacterAdded, function(character)
    task.spawn(setupCharacter, character)
end)

if player.Character then
    task.spawn(setupCharacter, player.Character)
end

-- TOGGLE
local function setEnabled(state)
    if unloaded then return end

    enabled = state

    toggle.Text = enabled
        and "Animation: ON"
        or "Animation: OFF"

    toggle.BackgroundColor3 = enabled
        and Color3.fromRGB(39, 155, 91)
        or Color3.fromRGB(145, 48, 55)

    if not enabled then
        restoreArm()
    end
end

connect(toggle.MouseButton1Click, function()
    setEnabled(not enabled)
end)

-- CUSTOM KEYBIND
connect(keyButton.MouseButton1Click, function()
    choosingKey = true
    keyButton.Text = "Press a key..."
end)

connect(UIS.InputBegan, function(input, processed)
    if input.UserInputType ~= Enum.UserInputType.Keyboard then
        return
    end

    if choosingKey then
        if input.KeyCode == Enum.KeyCode.Escape then
            choosingKey = false
            keyButton.Text = "Keybind: " .. toggleKey.Name
            return
        end

        if input.KeyCode ~= Enum.KeyCode.Unknown then
            toggleKey = input.KeyCode
            keyButton.Text = "Keybind: " .. toggleKey.Name
            choosingKey = false
        end

        return
    end

    if processed then return end

    if input.KeyCode == toggleKey then
        setEnabled(not enabled)
    end
end)

-- STABLE R15 ARM ANIMATION
connect(RunService.PreSimulation, function()
    if unloaded or not enabled then return end
    if not shoulder or not elbow then return end
    if not shoulder.Parent or not elbow.Parent then return end
    if not originalShoulder or not originalElbow then return end

    local movement = math.sin(os.clock() * speed)

    -- Override default arm movement during running
    shoulder.Transform = CFrame.identity
    elbow.Transform = CFrame.identity

    if wrist and wrist.Parent then
        wrist.Transform = CFrame.identity
    end

    -- Slightly relaxed shoulder, facing front-center
    shoulder.C0 = originalShoulder *
        CFrame.Angles(
            math.rad(30),
            math.rad(-15),
            math.rad(-50)
        )

    -- Elbow movement with adjustable speed
    elbow.C0 = originalElbow *
        CFrame.Angles(
            0,
            math.rad(-75),
            math.rad(10) + movement * math.rad(15)
        )

    -- Preserve your confirmed wrist rotation
    if wrist and wrist.Parent and originalWrist then
        wrist.C0 = originalWrist *
            CFrame.Angles(
                0,
                math.rad(90),
                0
            )
    end
end)

-- UNLOAD
connect(unloadButton.MouseButton1Click, function()
    if unloaded then return end

    enabled = false
    unloaded = true
    characterVersion = characterVersion + 1

    restoreArm()

    for _, connection in ipairs(connections) do
        connection:Disconnect()
    end

    table.clear(connections)
    gui:Destroy()
end)
